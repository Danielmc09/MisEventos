{
  "name": "mis-eventos-frontend",
  "version": "0.1.0",
  "description": "Frontend de Mis Eventos",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write src",
    "api:tipos": "openapi-typescript ${API_SCHEMA:-${VITE_API_URL:-http://localhost:8000}/openapi.json} -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts"
  },
  "type": "module",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-javascript-obfuscator": "3.1.0",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
