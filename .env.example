# ─────────────────────────────────────────────────────────────────────────────
# SOLO PARA DESARROLLO LOCAL.
# Valores de demostración que funcionan: `cp .env.example .env && docker compose up --build`.
# Con ENV=production la API se niega a arrancar con estas credenciales o con SEED_DEMO=true.
# El .env real nunca se sube al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

ENV=development

# Base de datos. POSTGRES_* crean la base en el contenedor `db` y tienen que coincidir con la URL.
POSTGRES_USER=miseventos
POSTGRES_PASSWORD=demo_local_db
POSTGRES_DB=miseventos
DATABASE_URL=postgresql+psycopg://miseventos:demo_local_db@db:5432/miseventos

# Autenticación. JWT_SECRET: mínimo 32 caracteres.
JWT_SECRET=demo-local-jwt-secret-solo-para-desarrollo-0001
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# Orígenes permitidos, separados por comas. `*` no se acepta.
CORS_ORIGINS=http://localhost:5173

# Datos de demostración: el backend corre el seed al arrancar si SEED_DEMO=true.
SEED_DEMO=true
ADMIN_EMAIL=admin@miseventos.local
ADMIN_PASSWORD=Admin-Demo-2026
# Contraseña de los dos usuarios demo que no son admin:
#   organizador@miseventos.local (Organizador) y asistente@miseventos.local (Asistente)
DEMO_PASSWORD=Demo-Local-2026

LOG_LEVEL=INFO

# Frontend: URL de la API, se fija al construir la imagen.
VITE_API_URL=http://localhost:8000
